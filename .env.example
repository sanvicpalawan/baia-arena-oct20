# Neon Postgres (Lakebase) — project spring-brook-21770189, branch production.
# `neon init` / `neon deploy` write these into .env.local. Do not hand-edit the
# connection strings; re-run `neon deploy` (or `neon env pull`) to refresh them.
#
#   DATABASE_URL            pooled (-pooler) — used by the app at runtime
#   DATABASE_URL_UNPOOLED   direct — used by drizzle-kit (push/migrations) only
#   NEON_BRANCH             branch name linked to this checkout
#
# On Vercel, add DATABASE_URL as a project environment variable (Production +
# Preview). DATABASE_URL_UNPOOLED is only needed if you run migrations remotely.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Admin passkey used to unlock the admin panel (three-click logo → passkey, or the
# footer Admin link). Change this after first deploy. Default is 5309 until changed
# in Admin → Security.
ADMIN_PASSKEY=5309
